{
  "name": "tmnt-events",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/render.jsx --outDir .render && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/*.mjs\" \"tests/*.mjs\" vite.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"scripts/*.mjs\" \"tests/*.mjs\" vite.config.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  }
}
